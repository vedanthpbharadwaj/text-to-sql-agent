# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Postgres (used by docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=nyc_taxi
ANALYST_RO_PASSWORD=analyst_ro

# Admin connection: only for loading data (scripts/*.py)
ADMIN_DATABASE_URL=postgresql://admin:admin@localhost:5432/nyc_taxi

# Read-only connection the agent uses when running outside Docker
DATABASE_URL=postgresql://analyst_ro:analyst_ro@localhost:5432/nyc_taxi

# Agent settings
MAX_ATTEMPTS=3
ENABLE_REVIEWER=true
STATEMENT_TIMEOUT_MS=30000
